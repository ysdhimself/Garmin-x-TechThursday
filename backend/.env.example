# Copy to backend/.env (git-ignored) and fill in. Never commit real keys.

# JEV = TypeSafe System One (https://api.typesafe.ai/docs). Classifies map-tile blocks as green space.
JEV_API_KEY=
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest      # or jev-preview (GET /v1/models lists them)
CLASSIFIER=jev            # jev | color (offline fallback, no key needed)
GREEN_MIN_SCORE=0.5       # block counts as green at or above this score (JEV: park ~0.8, plain map ~0.2)
BLOCK_PX=64               # block edge in tile pixels (~46 m at zoom 17 in Edmonton); smaller = more JEV images

# fixture = prepared demo plan, live = tiles + JEV + foot routing
ROUTING_MODE=fixture

# Map tiles that get cut into blocks (OSM tile policy: light demo use only)
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ZOOM=17

# OSRM-compatible router with a real foot profile (FOSSGIS public server; self-host for heavy use)
ROUTER_URL=https://routing.openstreetmap.de/routed-foot   # FOSSGIS OSRM foot profile, light use only
USER_AGENT=touch-grass-demo/0.1
